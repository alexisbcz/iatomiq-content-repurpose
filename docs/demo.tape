# Terminal part of docs/demo.mp4. Built by docs/build-demo.sh.
Output docs/terminal.mp4
Set Shell zsh
Set FontSize 15
Set Width 1280
Set Height 720
Set Padding 24
Set Theme "Catppuccin Mocha"
Set TypingSpeed 35ms

Hide
Type "setopt interactivecomments; clear"
Enter
Show

Type "# Repurpose a TikTok video into a LinkedIn post, in English, picking the frames where the prompt is typed"
Enter
Sleep 1s
Type "./bin/postwriter -video https://www.tiktok.com/@iatomiq/video/7705379385452383520 -lang en -tag demo -force \"
Enter
Type "  -overview 12 -visual-hint 'frames where the prompt is typed in ChatGPT, paired with the result'"
Sleep 1s
Enter
Sleep 200s
Sleep 2s
